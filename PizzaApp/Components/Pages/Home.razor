@page "/"
@inject IOrderApiService OrderApiService
@inject IRestaurantApiService RestaurantApiService

<h1>Beställda pizzor</h1>

@if (restaurants.Count == 0)
{
    <p>Inga Beställningar gjorda</p>
}
else
{
    <ul>
        @foreach (var restaurant in restaurants)
        {
            <li>
                <button @onclick="() => SelectRestaurant(restaurant)">                
                @restaurant.Name
                </button>
            </li>
        }
    </ul>

    @if (selectedRestaurant != null)
    {
        <h2>Meny: @selectedRestaurant.Name</h2>

        @if (isLoadingMenu)
        {
            <p>Laddar meny...</p>
        }
        else if (menuItems.Count == 0)
        {
            <p>Hittade ingen mat.</p>
        }
        else
        {
            <ul>
                @foreach (var menuItem in menuItems)
                {
                    <li>@menuItem.Name - @menuItem.Price kr</li>
                }
            </ul>
        }
    }

    <h2>Lägg till en ny beställning</h2>

    <EditForm Model="@orderInput" OnValidSubmit="CreateOrderAsync">

        <DataAnnotationsValidator />

        <div>
            <label>Namn</label>
            <InputText @bind-Value="orderInput.Name" />
            <ValidationMessage For="@(() => orderInput.Name)" />
        </div>

        <div>
            <label>Pizza</label>
            <InputText @bind-Value="orderInput.Pizza" />
            <ValidationMessage For="@(() => orderInput.Pizza)" />
        </div>

        <div>
            <label>Kommentar</label>
            <InputText @bind-Value="orderInput.Comment" />
            <ValidationMessage For="@(() => orderInput.Comment)" />
        </div>

        <button type="submit">
            Skapa beställning
        </button>

    </EditForm>


}

@code {

    // private string name = string.Empty;
    // private string pizza = string.Empty;
    // private string? comment;

    private PizzaOrderInput orderInput = new();
    private List<PizzaOrder> orders = new();    

    private List<MenuItem> menuItems = new();
    private bool isLoadingMenu;

    private Restaurant? selectedRestaurant;
    private List<Restaurant> restaurants = new();

    private async Task SelectRestaurant(Restaurant restaurant)
    {
        selectedRestaurant = restaurant;
        isLoadingMenu = true;

        menuItems = await RestaurantApiService.GetMenuAsync(restaurant.Id);
        isLoadingMenu = false;
    }    
   

    private async Task CreateOrderAsync()
    {
        var order = new PizzaOrder
        {
            Name = orderInput.Name,
            Pizza = orderInput.Pizza,
            Comment = orderInput.Comment
        };

        var createdOrder = await OrderApiService.CreateOrderAsync(order);

        if (createdOrder != null)
        {
            orders.Add(createdOrder);

            orderInput = new PizzaOrderInput(); // Reset the input fields
        }
    }

    protected override async Task OnInitializedAsync()
    {
        orders = await OrderApiService.GetOrdersAsync();

        restaurants = await RestaurantApiService.GetRestaurantsAsync();
    }
   
}