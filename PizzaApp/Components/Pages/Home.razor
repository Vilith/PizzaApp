@page "/"
@page "/pizzerian"
@page "/sperring"
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject IOrderApiService OrderApiService
@inject IRestaurantApiService RestaurantApiService
@inject IAuthService Auth
@implements IDisposable

@if (Auth.User == null)
{
    <Login />
}
else if (string.IsNullOrWhiteSpace(Auth.User.DisplayName))
{
    <ProfileSettings />
}
else
{
@if (CurrentSection == "")
{
    <section class="restaurant-lobby" aria-labelledby="lobby-heading">
    <h1 id="lobby-heading">Välj din dörr</h1>
    @if (loading)
    {
        <p role="status">Laddar restauranger…</p>
    }
    else
    {
        <div class="restaurant-grid">
            @foreach (var item in restaurants.Where(r => r.IsPizzeria || r.Name.Equals("Sperring", StringComparison.OrdinalIgnoreCase)).OrderByDescending(r => r.IsPizzeria))
            {
                <button class="restaurant-card" data-restaurant="@item.Id" @onclick="() => OpenRestaurant(item)">
                    <span class="door-window"><strong>@(item.IsPizzeria ? "Pizza" : "Sperring")</strong><span>Välkommen in</span></span>
                    <span class="door-panel" aria-hidden="true"></span>
                    <span class="door-handle" aria-hidden="true"></span>
                </button>
            }
        </div>
        @if (restaurants.Count == 0 && error == null) { <p>Det finns inga restauranger ännu.</p> }
    }
    </section>
}
else if (restaurant != null)
{
    <div class="restaurant-toolbar">
        <button class="text-button" data-action="restaurants" disabled="@(busy || loading)" @onclick="Back">← Till startsidan</button>
        <span class="restaurant-label">@(restaurant.IsPizzeria ? "Pizzerian" : "Sperring")</span>
    </div>
    <div class="page-heading">
        <div><p class="eyebrow">@restaurant.Name</p><h1>@(restaurant.IsPizzeria ? "Pizzerian" : "Sperring")</h1></div>
    </div>
    @if (loading)
    {
        <p role="status">Laddar meny och dagens lista…</p>
    }
    else if (daily != null)
    {
        @if (restaurant.IsPizzeria)
        {
            <div class="deadline @(daily.DeadlinePassed ? "deadline-late" : "")" role="status">
                <strong>Beställ senast @daily.Deadline</strong>
                <span>@(daily.IsLocked ? "Dagens beställningar är låsta." : daily.DeadlinePassed
                    ? "Deadline har passerat. Du kan fortfarande lägga till och ändra." : "Spara ditt val i den gemensamma listan. Tiden gäller svensk tid.")</span>
            </div>
        }
        <div class="order-grid">
            <section class="panel menu-panel" aria-labelledby="menu-heading">
                <p class="eyebrow">VÄLJ DIN FAVORIT</p>
                <h2 id="menu-heading">@(restaurant.IsPizzeria ? "Meny" : "À la carte")</h2>
                @if (menu.Count == 0) { <p>Menyn är inte upplagd ännu.</p> }
                @if (restaurant.IsPizzeria)
                {
                    <div class="menu-tabs" role="tablist" aria-label="Menysektioner">
                        @foreach (var tab in menu.Select(MenuTab).Distinct())
                        {
                            <button type="button" role="tab" id="@TabId(tab)" aria-controls="menu-tab-panel"
                                    aria-selected="@(ActiveTab == tab ? "true" : "false")"
                                    class="@(ActiveTab == tab ? "active" : "")" @onclick="() => activeTab = tab">@tab</button>
                        }
                    </div>
                }
                <div id="menu-tab-panel" role="@(restaurant.IsPizzeria ? "tabpanel" : null)"
                     aria-labelledby="@(restaurant.IsPizzeria ? TabId(ActiveTab) : null)">
                @foreach (var group in menu.Where(item => !restaurant.IsPizzeria || MenuTab(item) == ActiveTab)
                    .GroupBy(item => string.IsNullOrWhiteSpace(item.Category)
                        ? (restaurant.IsPizzeria ? "Pizzor" : "À la carte") : item.Category))
                {
                    <section class="menu-category" aria-label="@group.Key">
                        @if (restaurant.IsPizzeria) { <h3>@group.Key</h3> }
                        @if (restaurant.IsPizzeria && group.Key == "Pizzor")
                        {
                            <p>Tomat och ost ingår i alla pizzor.</p>
                        }
                        <div class="menu-list">
                            @foreach (var item in group)
                            {
                                <button class="menu-item @(input?.MenuItemId == item.Id ? "selected" : "")" data-menu-item="@item.Id"
                                        disabled="@(busy || daily.IsLocked)" @onclick="() => SelectItem(item)">
                                    @if (item.MenuNumber.HasValue)
                                    {
                                        <span class="menu-number" aria-hidden="true">@item.MenuNumber</span>
                                    }
                                    <span>
                                        <strong>@item.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(item.Description))
                                        {
                                            <small>@item.Description</small>
                                        }
                                        <small>@item.Price.ToString("0.##") kr</small>
                                    </span>
                                    <span class="add-icon" aria-hidden="true">+</span>
                                </button>
                            }
                        </div>
                    </section>
                }
                </div>
            </section>
            <section id="selection-panel" tabindex="-1" class="panel selection-panel" aria-labelledby="selection-heading">
                @if (input == null)
                {
                    <div class="empty-selection"><span aria-hidden="true">＋</span><h2 id="selection-heading">Gör ditt val</h2><p>Välj en rätt från menyn för att lägga till den i dagens lista.</p></div>
                }
                else
                {
                    <p class="eyebrow">@(editingId.HasValue ? "ÄNDRA BESTÄLLNING" : "DITT VAL")</p>
                    <h2 id="selection-heading">@menu.FirstOrDefault(m => m.Id == input.MenuItemId)?.Name</h2>
                    <EditForm Model="input" OnValidSubmit="Save" @key="input">
                        <DataAnnotationsValidator />
                        <ValidationSummary />
                        <fieldset disabled="@(busy || daily.IsLocked)">
                            @if (restaurant.IsPizzeria)
                            {
                                <label for="sauce">Välj sås <span>(obligatoriskt)</span></label>
                                <InputSelect id="sauce" class="form-select" @bind-Value="input.Sauce" required>
                                    <option value="">Välj sås…</option>
                                    @foreach (var sauce in PizzaChoices.Sauces) { <option value="@sauce">@sauce</option> }
                                </InputSelect>
                                <label for="drink">Välj dryck <span>(obligatoriskt)</span></label>
                                <InputSelect id="drink" class="form-select" @bind-Value="input.Drink" required>
                                    <option value="">Välj dryck…</option>
                                    @foreach (var drink in PizzaChoices.Drinks) { <option value="@drink">@drink</option> }
                                </InputSelect>
                            }
                            <div class="form-row">
                                <div><label for="quantity">Antal</label><InputNumber id="quantity" class="form-control" @bind-Value="input.Quantity" min="1" max="99" /></div>
                                <div><label>Beställare</label><p class="order-profile-name">@(editingId.HasValue ? input.Name : Auth.User.DisplayName)</p></div>
                            </div>
                            <label for="comment">Kommentar <span>(valfritt)</span></label>
                            <InputTextArea id="comment" class="form-control" @bind-Value="input.Comment" maxlength="500" placeholder="Till exempel utan lök" />
                            <div class="form-actions">
                                <button class="btn btn-primary" type="submit">@(busy ? "Sparar…" : editingId.HasValue ? "Spara ändringar" : "Spara beställning")</button>
                                <button class="text-button" type="button" @onclick="CancelEdit">Avbryt</button>
                            </div>
                        </fieldset>
                    </EditForm>
                }
            </section>
        </div>
        @if (success != null) { <div class="alert alert-success" role="status">@success</div> }
        <section id="daily-list" class="panel daily-panel" aria-labelledby="daily-heading">
            <div class="list-heading">
                <div><p class="eyebrow">@daily.Date.ToString("yyyy-MM-dd") · @restaurant.Name</p><h2 id="daily-heading">Dagens beställningslista</h2></div>
                <button class="btn btn-outline-primary" disabled="@busy" @onclick="Refresh">Uppdatera listan</button>
            </div>
            @if (daily.CollectedAt != null)
            {
                <p class="muted" role="status">Hämtad och sparad i historiken. Dagens lista är rensad.</p>
            }
            else
            {
            <p class="muted">Gemensam lista · @daily.Orders.Sum(o => o.Quantity) portioner · Hämtad @lastRefreshed</p>
            @if (daily.Orders.Count == 0)
            {
                <div class="empty-list">Ingen har beställt ännu. Lägg till dagens första rätt!</div>
            }
            else
            {
                <div class="summary-box">
                    <h3>Att ringa in</h3><p>Kryssa i de som kan hämta. Låt bara de som faktiskt hämtade vara ikryssade när dagen avslutas.</p>
                    @foreach (var person in daily.Orders.GroupBy(o => new { o.OwnerUserId, Name = o.Name.ToUpperInvariant() }).OrderBy(g => g.Key.Name))
                    {
                        var representative = person.First();
                        <label class="collector-row">
                            <input type="checkbox" data-collector="@representative.Id" checked="@person.Any(o => o.CanCollect)"
                                   disabled="@(busy || daily.CollectedAt != null || !CanEdit(representative) || string.IsNullOrWhiteSpace(representative.Name))"
                                   @onchange="e => SetCollector(representative, e.Value is true)" />
                            <span>@(string.IsNullOrWhiteSpace(representative.Name) ? "Utan namn (ange namn för att kunna hämta)" : representative.Name)</span>
                        </label>
                    }
                </div>
                @if (restaurant.IsPizzeria)
                {
                    <details class="individual-orders" data-list="drinks">
                        <summary>Alla drycker (@daily.Orders.Where(o => o.Drink != null).Sum(o => o.Quantity))</summary>
                        @foreach (var drink in daily.Orders.Where(o => o.Drink != null).GroupBy(o => o.Drink).OrderBy(g => g.Key))
                        {
                            <div class="order-row"><strong>@drink.Sum(o => o.Quantity) × @drink.Key</strong></div>
                        }
                    </details>
                }
                <details class="individual-orders" open>
                    <summary>Alla beställningar (@daily.Orders.Count)</summary>
                    @foreach (var order in daily.Orders)
                    {
                        <div class="order-row" @key="order.Id">
                            <div><strong>@order.Quantity × @order.Pizza</strong><span>@Extras(order.Sauce, order.Drink)</span>
                                @if (!string.IsNullOrWhiteSpace(order.Comment)) { <span class="order-comment">@order.Comment</span> }
                                <small>@(string.IsNullOrWhiteSpace(order.Name) ? "Utan namn" : order.Name)</small>
                            </div>
                            @if (CanEdit(order))
                            {
                            <div class="row-actions">
                                <button class="text-button" data-edit="@order.Id" disabled="@(busy || daily.IsLocked)" @onclick="() => Edit(order)">Ändra</button>
                                <button class="text-button danger" data-delete="@order.Id" disabled="@(busy || daily.IsLocked)" @onclick="() => deleteId = order.Id">Ta bort</button>
                            </div>
                            }
                            @if (deleteId == order.Id)
                            {
                                <div class="delete-confirm" role="alert"><span>Ta bort @order.Quantity × @order.Pizza?</span>
                                    <button class="btn btn-danger btn-sm" disabled="@busy" @onclick="() => Delete(order)">Ja, ta bort</button>
                                    <button class="text-button" disabled="@busy" @onclick="() => deleteId = null">Avbryt</button>
                                </div>
                            }
                        </div>
                    }
                </details>
                @if (Auth.User.IsAdmin)
                {
                <div class="completion-box">
                        <p>Dagens beställning låses och sparas för framtida statistik när den är hämtad.</p>
                        <button class="btn btn-primary" data-action="complete" disabled="@(busy || !daily.Orders.Any(o => o.CanCollect))" @onclick="Complete">
                            @(restaurant.IsPizzeria ? "Pizzorna är hämtade" : "Maten är hämtad")
                        </button>
                </div>
                }
                else
                {
                    <p class="muted">En administratör avslutar dagens beställning när maten är hämtad.</p>
                }
            }
            }
        </section>
    }
}
@if (CurrentSection != "" && restaurant == null && loading)
{
    <p role="status">Laddar restaurangen…</p>
}
@if (error != null)
{
    <div class="alert alert-danger mt-3" role="alert">@error</div>
    <button class="btn btn-outline-primary" disabled="@(busy || loading)" @onclick="Reload">Hämta senaste uppgifter</button>
}

}

@code {
    private string CurrentSection => Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/').ToLowerInvariant();
    private async Task OpenRestaurant(Restaurant item)
    {
        try { await JS.InvokeVoidAsync("pizzaEntrance.play", item.IsPizzeria ? "Pizza" : "Sperring"); }
        catch (JSException) { /* Navigation still works if the optional animation fails. */ }
        Navigation.NavigateTo(item.IsPizzeria ? "/pizzerian" : "/sperring");
    }
    private void LocationChanged(object? sender, LocationChangedEventArgs args) => _ = InvokeAsync(async () =>
    {
        loadVersion++;
        if (CurrentSection is not ("" or "pizzerian" or "sperring")) return;
        restaurant = null; daily = null; input = null; menu = [];
        editingId = deleteId = null; error = success = null;
        if (!string.IsNullOrWhiteSpace(Auth.User?.DisplayName)) await LoadRestaurants();
        StateHasChanged();
    });
    private Guid? loadedUser;
    private int loadVersion;
    private bool CanEdit(OrderDetails order) => Auth.User is { } user && (user.IsAdmin || order.OwnerUserId == user.Id);

    private void AuthChanged() => _ = InvokeAsync(async () =>
    {
        if (loadedUser != Auth.User?.Id)
        {
            loadVersion++;
            loadedUser = Auth.User?.Id;
            restaurant = null; daily = null; input = null; menu = []; restaurants = [];
            editingId = deleteId = null; error = success = null;
            loading = false;
        }
        if (Auth.User is { DisplayName.Length: > 0 } && restaurants.Count == 0 && !loading) await LoadRestaurants();
        StateHasChanged();
    });

    public void Dispose()
    {
        loadVersion++;
        Auth.Changed -= AuthChanged;
        Navigation.LocationChanged -= LocationChanged;
    }
    private List<Restaurant> restaurants = [];
    private List<MenuItem> menu = [];
    private Restaurant? restaurant;
    private DailyOrderList? daily;
    private OrderInput? input;
    private int? editingId;
    private int? deleteId;
    private bool loading = true;
    private bool busy;
    private string? error;
    private string? success;
    private string lastRefreshed = "";
    private string? activeTab;
    private bool focusSelection;
    private static string MenuTab(MenuItem item) => item.Category is "" or "Pizzor"
        ? item.MenuNumber switch { <= 12 => "Pizzor 1–12", <= 24 => "Pizzor 13–24", <= 33 => "Pizzor 25–33", _ => "Pizzor 34–43" }
        : item.Category;
    private string ActiveTab => activeTab ?? menu.Select(MenuTab).FirstOrDefault() ?? "";
    private static string TabId(string tab) => "tab-" + tab.Replace(' ', '-');
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!focusSelection) return;
        focusSelection = false;
        await JS.InvokeVoidAsync("pizzaPage.center", "selection-panel");
    }

    protected override async Task OnInitializedAsync()
    {
        Auth.Changed += AuthChanged;
        Navigation.LocationChanged += LocationChanged;
        loadedUser = Auth.User?.Id;
        if (!string.IsNullOrWhiteSpace(Auth.User?.DisplayName)) await LoadRestaurants();
        else loading = false;
    }

    private static bool IsConnectionError(Exception ex) => ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException or OrderApiException or AuthException;
    private static string Extras(string? sauce, string? drink) => string.Join(" · ", new[] { sauce, drink }.Where(s => !string.IsNullOrEmpty(s)));

    private async Task LoadRestaurants()
    {
        var version = loadVersion;
        loading = true; error = null;
        try
        {
            var result = await RestaurantApiService.GetRestaurantsAsync();
            if (version != loadVersion) return;
            restaurants = result;
            if (CurrentSection != "")
            {
                var selected = restaurants.FirstOrDefault(r => CurrentSection == "pizzerian"
                    ? r.IsPizzeria : r.Name.Equals("Sperring", StringComparison.OrdinalIgnoreCase));
                if (selected != null) await SelectRestaurant(selected);
                else error = "Restaurangen kunde inte hittas.";
            }
        }
        catch (Exception ex) when (IsConnectionError(ex)) { if (version == loadVersion) error = "Kunde inte hämta restaurangerna. Kontrollera anslutningen och försök igen."; }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task SelectRestaurant(Restaurant selected)
    {
        var version = loadVersion;
        activeTab = null; focusSelection = false; restaurant = selected; daily = null; menu = []; input = null; editingId = deleteId = null;
        loading = true; error = success = null;
        try
        {
            var result = await RestaurantApiService.GetMenuAsync(selected.Id);
            if (version != loadVersion) return;
            menu = result;
            await LoadList();
        }
        catch (Exception ex) when (IsConnectionError(ex)) { if (version == loadVersion) error = "Kunde inte hämta menyn och dagens lista. Försök igen."; }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task LoadList()
    {
        var version = loadVersion;
        var result = await OrderApiService.GetTodayAsync(restaurant!.Id);
        if (version != loadVersion) return;
        daily = result;
        lastRefreshed = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(DateTimeOffset.UtcNow, "Europe/Stockholm").ToString("HH:mm:ss");
    }

    private async Task Refresh()
    {
        if (busy) return;
        busy = true; error = null;
        try { await LoadList(); }
        catch (Exception ex) when (IsConnectionError(ex)) { error = "Kunde inte uppdatera listan. Uppgifterna som visas kan vara gamla."; }
        finally { busy = false; }
    }

    private Task SetCollector(OrderDetails order, bool canCollect) => UpdateCollection(() =>
        OrderApiService.SetCollectorAsync(restaurant!.Id, order.Id, new(canCollect, order.Revision, daily!.Date)));

    private Task Complete() => UpdateCollection(() => OrderApiService.CompleteAsync(restaurant!.Id,
        new(daily!.Date, daily.Orders.ToDictionary(o => o.Id, o => o.Revision))));

    private async Task UpdateCollection(Func<Task<DailyOrderList>> action)
    {
        if (busy || daily == null || daily.CollectedAt != null) return;
        var version = loadVersion;
        busy = true; error = success = null;
        try
        {
            var result = await action();
            if (version != loadVersion) return;
            daily = result;
            if (daily.CollectedAt != null) { CancelEdit(); deleteId = null; }
        }
        catch (OrderApiException ex) { error = ex.Message; }
        catch (Exception ex) when (IsConnectionError(ex))
        { error = "Kunde inte läsa serverns svar. Uppdatera listan för att se om hämtningen sparats."; }
        finally { busy = false; }
    }

    private Task Reload() => restaurant == null ? LoadRestaurants() : daily == null ? SelectRestaurant(restaurant) : Refresh();
    private void Back() { if (busy || loading) return; Navigation.NavigateTo("/"); }
    private void CancelEdit() { input = null; editingId = null; }
    private void SelectItem(MenuItem item)
    {
        if (busy || daily?.IsLocked != false) return;
        if (input == null) input = new() { Name = Auth.User?.DisplayName ?? "" };
        input.MenuItemId = item.Id;
        input.Sauce = restaurant?.IsPizzeria == true ? MenuSauce.DefaultFor(item.Description) : null;
        focusSelection = true;
        error = success = null;
    }
    private void Edit(OrderDetails order)
    {
        focusSelection = true;
        editingId = order.Id; error = success = null;
        input = new() { MenuItemId = order.MenuItemId, Quantity = order.Quantity, Name = order.Name,
            Sauce = order.Sauce, Drink = order.Drink, Comment = order.Comment, Revision = order.Revision };
    }

    private async Task Save()
    {
        if (busy || input == null || restaurant == null || daily?.IsLocked != false) return;
        var version = loadVersion;
        if (restaurant.IsPizzeria && (string.IsNullOrEmpty(input.Sauce) || string.IsNullOrEmpty(input.Drink)))
        { error = "Välj sås och dryck innan du sparar."; return; }
        busy = true; error = success = null;
        try
        {
            await OrderApiService.SaveAsync(restaurant.Id, input, editingId);
            if (version != loadVersion) return;
            input = null; editingId = null;
            success = "Beställningen är sparad i dagens lista.";
            try { await LoadList(); }
            catch (Exception ex) when (IsConnectionError(ex)) { error = "Beställningen sparades, men listan kunde inte uppdateras. Hämta senaste uppgifter."; }
        }
        catch (OrderApiException ex) { error = ex.Message; }
        catch (Exception ex) when (IsConnectionError(ex))
        { error = "Svaret från servern kunde inte läsas. Beställningen kan ha sparats. Uppdatera listan innan du försöker igen."; }
        finally { busy = false; }
    }

    private async Task Delete(OrderDetails order)
    {
        if (busy || restaurant == null || daily?.IsLocked != false) return;
        var version = loadVersion;
        busy = true; error = success = null;
        try
        {
            await OrderApiService.DeleteAsync(restaurant.Id, order.Id, order.Revision);
            if (version != loadVersion) return;
            deleteId = null;
            if (editingId == order.Id) CancelEdit();
            success = "Beställningen är borttagen.";
            await LoadList();
        }
        catch (OrderApiException ex) { error = ex.Message; }
        catch (Exception ex) when (IsConnectionError(ex)) { error = "Kunde inte läsa serverns svar. Uppdatera listan för att se om beställningen är borttagen."; }
        finally { busy = false; }
    }
}
