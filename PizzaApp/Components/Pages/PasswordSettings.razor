@inject IAuthService Auth
@implements IDisposable

@if (Auth.User != null)
{
    <section class="password-section" aria-labelledby="password-heading">
        <h2 id="password-heading">Byt lösenord</h2>
        @if (Auth.User.MustChangePassword)
        {
            <p role="status">Du har ett tillfälligt lösenord. Välj ett eget innan du fortsätter.</p>
        }

        <EditForm Model="change" OnValidSubmit="Change">
            <DataAnnotationsValidator /><ValidationSummary />
            <fieldset disabled="@busy">
                <label for="current-password">Nuvarande eller tillfälligt lösenord</label>
                <InputText id="current-password" type="password" autocomplete="current-password" class="form-control mb-3" @bind-Value="change.CurrentPassword" />
                <label for="new-password">Nytt lösenord (minst 8 tecken)</label>
                <InputText id="new-password" type="password" autocomplete="new-password" class="form-control mb-3" @bind-Value="change.NewPassword" />
                <label for="confirm-password">Upprepa nytt lösenord</label>
                <InputText id="confirm-password" type="password" autocomplete="new-password" class="form-control mb-3" @bind-Value="change.ConfirmPassword" />
                <button type="submit" class="btn btn-primary">Byt lösenord och logga ut</button>
            </fieldset>
        </EditForm>

        @if (Auth.User.IsAdmin && !Auth.User.MustChangePassword)
        {
            <hr />
            <h2>Återställ kollegas lösenord</h2>
            <p>Välj kollega och bekräfta med ditt eget lösenord. Kollegans gamla lösenord ersätts.</p>
            <button type="button" class="btn btn-outline-primary mb-3" disabled="@busy" @onclick="LoadAccounts">Hämta användare</button>

            @if (accounts.Count > 0)
            {
                <EditForm Model="reset" OnValidSubmit="Reset">
                    <DataAnnotationsValidator /><ValidationSummary />
                    <fieldset disabled="@busy">
                        <label for="reset-account">Kollega</label>
                        <InputSelect id="reset-account" class="form-select mb-3" @bind-Value="reset.UserId">
                            <option value="@Guid.Empty">Välj kollega…</option>

                            @foreach (var account in accounts)
                            {
                                <option value="@account.Id">@account.DisplayName (@account.Email)</option>
                            }
                        </InputSelect>

                        <label for="admin-password">Ditt lösenord</label>
                        <InputText id="admin-password" type="password" autocomplete="current-password" class="form-control mb-3" @bind-Value="reset.AdminPassword" />
                        <button type="submit" class="btn btn-outline-danger">Skapa tillfälligt lösenord</button>
                    </fieldset>
                </EditForm>
            }
            @if (temporary != null)
            {
                <div class="alert alert-success mt-3" role="status">
                    <p>Tillfälligt lösenord för <strong>@resetName</strong>:</p>
                    <code class="temporary-password">@temporary</code>
                    <p>Lämna det privat till kollegan. Det visas bara här och kan inte hämtas igen. Kollegan måste välja ett eget efter inloggning.</p>
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => temporary = null">Dölj lösenord</button>
                </div>
            }
        }
        @if (error != null) { <p class="alert alert-danger mt-3" role="alert">@error</p> }
    </section>
}

@code {
    private ChangePasswordInput change = new();
    private ResetPasswordInput reset = new();
    private List<PasswordAccount> accounts = [];
    private bool busy;
    private string? temporary, resetName, error;
    private Guid? accountId;

    protected override void OnInitialized() { accountId = Auth.User?.Id; Auth.Changed += Changed; }

    private void Changed() => _ = InvokeAsync(() =>
    {
        if (accountId != Auth.User?.Id) { Clear(); accountId = Auth.User?.Id; }
        StateHasChanged();
    });

    private void Clear() { change = new(); reset = new(); temporary = resetName = error = null; accounts = []; }

    public void Dispose() { Auth.Changed -= Changed; Clear(); }

    private async Task Run(Func<Task> action)
    {
        if (busy) return;
        busy = true; error = null; temporary = null;

        try { await action(); }
        catch (AuthException ex) { error = ex.Message; }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or System.Text.Json.JsonException)
        { error = "Svaret kunde inte läsas. Vid lösenordsbyte: prova det nya lösenordet. Vid återställning: gör om för att få ett nytt."; }

        finally { busy = false; change = new(); reset.AdminPassword = ""; }
    }

    private Task LoadAccounts() => Run(async () => accounts = await Auth.GetPasswordAccountsAsync());

    private Task Change() => Run(() => Auth.ChangePasswordAsync(change));

    private Task Reset() => Run(async () =>
    {
        var selected = accounts.SingleOrDefault(a => a.Id == reset.UserId);

        if (selected == null) { error = "Välj en kollega."; return; }

        var result = await Auth.ResetPasswordAsync(reset);
        resetName = selected.DisplayName;
        temporary = result.Password;
    });
}
