<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <!-- BYGGINSTÄLLNINGAR: ramverk, nullable och projektspecifika kompilatorval. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
  </PropertyGroup>
  <!-- BEROENDEN OCH FILER: paket, projektreferenser eller delad källkod. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <ProjectReference Include="../PizzaApp.Shared/PizzaApp.Shared.csproj" />
  </ItemGroup>
</Project>
